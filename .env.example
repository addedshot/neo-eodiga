# 이 파일을 복사해 .env.local을 만들고 값을 채운다. .env.local은 git에 올라가지 않는다. 키 값은 채팅이나 문서에 적지 않는다.

# 한국관광공사 관광정보 API 인증키(공공데이터포털 마이페이지 → 인증키, "일반 인증키(Decoding)").
# 축제·명소·숙소·먹을 곳 자료 받기(build-festivals, build-attractions, build-food-details, build-region-centers)와
# 관광지 집중률, 행정안전부 모범음식점(build-badges)에 같은 키를 쓴다.
TOUR_API_KEY=

# 식품안전나라 오픈API 인증키(식품안전나라 → 마이페이지 → 인증키 신청현황). 위생등급 지정 표시(build-badges)에 쓴다.
# 비워 두면 지난 색인의 위생등급을 그대로 쓴다.
FOOD_SAFETY_API_KEY=

# 카카오맵 JavaScript 키. 카카오 개발자 사이트에서 발급하고 사이트 도메인을 등록해야 한다.
# 비워 두면 후기 상세에서 지도 없이 방문 순서 목록만 보여준다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 사진 원본 폴더(저장소 밖). npm run strip-exif -- <slug>가 <폴더>/<slug>/의 사진에서 위치정보를 지운 사본을 만든다.
PHOTO_SOURCE_DIR=
